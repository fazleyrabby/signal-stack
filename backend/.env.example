# --- Database ---
DB_NAME=signalstack
DB_USER=signal
DB_PASSWORD=signal
DATABASE_URL="postgresql://${DB_USER}:${DB_PASSWORD}@localhost:5433/${DB_NAME}"

# --- GeoIP (MaxMind) ---
GEOIPUPDATE_ACCOUNT_ID=YOUR_ACCOUNT_ID
GEOIPUPDATE_LICENSE_KEY=YOUR_LICENSE_KEY

# --- Security ---
ADMIN_API_KEY="dev-admin-key"

# --- AI Intelligence Tier (Phase 3) ---
# For Groq (Recommended for Speed):
# AI_API_URL="https://api.groq.com/openai/v1/chat/completions"
# AI_API_KEY="your-groq-api-key"
# AI_MODEL="llama-3.3-70b-versatile"

# For OpenRouter:
# AI_API_URL="https://openrouter.ai/api/v1/chat/completions"
# AI_API_KEY="your-openrouter-api-key"
# AI_MODEL="meta-llama/llama-3.1-405b-instruct"

# --- PicoClaw & Mac Local (Phase 4) ---
# PICOCLAW_URL="http://192.168.0.213:9000"
# PICOCLAW_TIMEOUT=3000
# PICOCLAW_ENABLED=true

# --- Alerts ---
DISCORD_WEBHOOK_URL="your-discord-webhook-url"
DISCORD_JOBS_WEBHOOK_URL="your-jobs-discord-webhook-url"
DISCORD_FILTER_TECH="true"
DISCORD_ALERT_CATEGORIES=technology  # comma-separated, e.g. technology,geopolitics

# --- Data Retention ---
SIGNAL_RETENTION_DAYS=90
JOB_RETENTION_DAYS=14

# --- Misc ---
PORT=3000
NODE_ENV=development
